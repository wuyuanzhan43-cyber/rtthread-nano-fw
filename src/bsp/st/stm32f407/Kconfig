# ---------------------------------------------------------------------------
# STM32F407 芯片级配置
#
# 只包含“芯片相关”的选择：时钟源和由时钟源推导出的总线频率/
# Flash 等待周期。具体引脚映射在 board 目录的 Kconfig 中。
# ---------------------------------------------------------------------------
menu "STM32F407 chip"
    depends on FW_PLATFORM_STM32F407VE

# 系统时钟二选一：
#   HSI 16MHz  - 内部 RC，无需晶振，最低成本/最低门槛；
#   HSE 8MHz   - 外部晶振，PLL 到 168MHz，适合需要高主频/精确波特率的场景。
# stm32f407_clock.c 根据这两个符号选择不同的初始化路径。
choice BOARD_CLOCK_SOURCE
    prompt "System clock"
    default BOARD_CLOCK_HSI_16

config BOARD_CLOCK_HSI_16
    bool "HSI 16 MHz (default, no crystal)"

config BOARD_CLOCK_HSE_8_168
    bool "HSE 8 MHz -> PLL -> 168 MHz"
endchoice

# 外部晶振频率；只有选择 HSE 时非零。
# stm32f4xx_hal_conf.h 会把它写入 HSE_VALUE，HAL RCC 初始化依赖该值。
config BOARD_HSE_VALUE
    int
    default 8000000 if BOARD_CLOCK_HSE_8_168
    default 0

# 以下频率/等待周期都由时钟源推导，不单独提示用户修改：
#   SYSCLK - CPU 主频；
#   PCLK1  - APB1 频率（USART2/3、SPI2/3）；
#   PCLK2  - APB2 频率（USART1、SPI1）；
#   FLASH_LATENCY - 168MHz 下必须为 5，16MHz 下为 0。
config BOARD_SYSCLK_HZ
    int
    default 16000000 if BOARD_CLOCK_HSI_16
    default 168000000 if BOARD_CLOCK_HSE_8_168

config BOARD_PCLK1_HZ
    int
    default 16000000 if BOARD_CLOCK_HSI_16
    default 42000000 if BOARD_CLOCK_HSE_8_168

config BOARD_PCLK2_HZ
    int
    default 16000000 if BOARD_CLOCK_HSI_16
    default 84000000 if BOARD_CLOCK_HSE_8_168

config BOARD_FLASH_LATENCY
    int
    default 0 if BOARD_CLOCK_HSI_16
    default 5 if BOARD_CLOCK_HSE_8_168
endmenu

# 逐实例 UART/SPI 开关。
source "src/bsp/st/stm32f407/driver/Kconfig"
