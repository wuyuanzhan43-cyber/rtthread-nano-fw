# ---------------------------------------------------------------------------
# STM32F407VE 板级构建选项
#
# 板级拓扑（身份、内存、时钟、引脚/AF、设备绑定、LCD 面板参数）只存在于：
#   boards/stm32f407ve/board.json
#   chips/stm32f407.json
#   profiles/<profile>/profile.json（选择 board/chip/clock variant）
#
# 本文件只保留构建策略：启用项、波特率、IRQ 优先级、SPI 频率、最小栈。
# 修改 manifest 后运行：
#   python tools/fwconfig.py sync --all
# ---------------------------------------------------------------------------
menu "Board build options: STM32F407VE"
    depends on FW_PLATFORM_STM32F407VE

config BOARD_LED_ENABLE
    bool "Enable LED"
    default y

config BOARD_LCD_ENABLE
    bool "Enable ST7735S LCD"
    depends on FW_USE_DISPLAY
    default y

config BOARD_UART_BAUD
    int "Default UART baud rate"
    default 115200
    range 1200 4000000

config BOARD_UART_IRQ_PRIORITY
    int "UART IRQ priority"
    default 6
    range 0 15

config BOARD_DMA_IRQ_PRIORITY
    int "DMA stream IRQ priority"
    default 7
    range 0 15

config BOARD_EXTI_IRQ_PRIORITY
    int "EXTI IRQ priority"
    default 8
    range 0 15

# SPI 引脚/AF 来自 manifest；这里只保留是否使用 MISO 和频率上限。
config BOARD_SPI1_USE_MISO
    bool "SPI1 use MISO"
    default n

config BOARD_SPI1_MAX_HZ
    int "SPI1 max frequency"
    default 12000000
    range 1000000 42000000

config BOARD_SPI2_USE_MISO
    bool "SPI2 use MISO"
    default y

config BOARD_SPI2_MAX_HZ
    int "SPI2 max frequency"
    default 12000000
    range 1000000 42000000

config BOARD_SPI3_USE_MISO
    bool "SPI3 use MISO"
    default y

config BOARD_SPI3_MAX_HZ
    int "SPI3 max frequency"
    default 12000000
    range 1000000 42000000

config BOARD_MIN_STACK_SIZE
    int "Minimum main/ISR stack (bytes)"
    default 4096
    range 1024 65536

endmenu
