# ---------------------------------------------------------------------------
# STM32F407VE 板级构建选项
#
# 板级接线（身份、内存、引脚/AF、通道、LCD、NVM）在 board_config.h 手写 C 表。
# 本文件只保留构建/运行策略，生成到 board_policy.h：
#   时钟源、启用项、波特率、IRQ 优先级、SPI/I2C/ADC/PWM 参数、IWDG、fault。
# ---------------------------------------------------------------------------
menu "Board build options: STM32F407VE"
    depends on FW_PLATFORM_STM32F407VE

choice
    prompt "Board clock source"
    default BOARD_CLOCK_HSI_16

config BOARD_CLOCK_HSI_16
    bool "HSI 16 MHz (no external crystal)"

config BOARD_CLOCK_HSE_8_168
    bool "HSE 8 MHz -> 168 MHz"
endchoice

config BOARD_LED_ENABLE
    bool "Enable LED"
    default y

config BOARD_LCD_ENABLE
    bool "Enable ST7735S LCD"
    depends on FW_USE_DISPLAY
    default y

config BOARD_UART_BAUD
    int "Default UART baud rate"
    default 115200
    range 1200 4000000

config BOARD_UART_IRQ_PRIORITY
    int "UART IRQ priority"
    default 6
    range 0 15

config BOARD_DMA_IRQ_PRIORITY
    int "DMA stream IRQ priority"
    default 7
    range 0 15

config BOARD_EXTI_IRQ_PRIORITY
    int "EXTI IRQ priority"
    default 8
    range 0 15

# SPI 引脚/AF 在 board_config.h；这里只保留 MISO 与频率上限。
config BOARD_SPI1_USE_MISO
    bool "SPI1 use MISO"
    default n

config BOARD_SPI1_MAX_HZ
    int "SPI1 max frequency"
    default 12000000
    range 1000000 42000000

config BOARD_SPI2_USE_MISO
    bool "SPI2 use MISO"
    default y

config BOARD_SPI2_MAX_HZ
    int "SPI2 max frequency"
    default 12000000
    range 1000000 42000000

config BOARD_SPI3_USE_MISO
    bool "SPI3 use MISO"
    default y

config BOARD_SPI3_MAX_HZ
    int "SPI3 max frequency"
    default 12000000
    range 1000000 42000000

# I2C 引脚/AF 在 board_config.h；速度属于板级电气策略。
config BOARD_I2C1_SPEED_HZ
    int "I2C1 speed (Hz)"
    depends on FW_USING_I2C1
    default 100000
    range 10000 400000

config BOARD_I2C2_SPEED_HZ
    int "I2C2 speed (Hz)"
    depends on FW_USING_I2C2
    default 100000
    range 10000 400000

config BOARD_I2C3_SPEED_HZ
    int "I2C3 speed (Hz)"
    depends on FW_USING_I2C3
    default 100000
    range 10000 400000

# ADC 电气参数；通道/引脚在 board_config.h。
config BOARD_ADC1_VREF_MV
    int "ADC1 reference voltage (mV)"
    depends on FW_USING_ADC1
    default 3300
    range 1000 5000

config BOARD_ADC1_RESOLUTION_BITS
    int "ADC1 resolution bits"
    depends on FW_USING_ADC1
    default 12
    range 8 12
    help
        STM32F407 HAL supports 8/10/12 bits.

config BOARD_ADC1_SAMPLE_CYCLES
    int "ADC1 sample time (ADC clock cycles)"
    depends on FW_USING_ADC1
    default 84
    range 3 480
    help
        Must be one of 3/15/28/56/84/112/144/480.

config BOARD_PWM4_PERIOD_HZ
    int "PWM4 frequency (Hz)"
    depends on FW_USING_PWM4
    default 1000
    range 1 1000000

config BOARD_IWDG_ENABLE
    bool "Enable independent watchdog (IWDG)"
    default n
    help
        Start IWDG after all devices/tasks are ready. main only feeds it
        while no managed task is LOST. Once started it cannot be stopped.

config BOARD_IWDG_TIMEOUT_MS
    int "IWDG timeout (ms)"
    depends on BOARD_IWDG_ENABLE
    default 5000
    range 100 30000
    help
        Estimated with LSI=32kHz; actual timeout varies with the LSI.
        Keep it above APP_TASK_HEARTBEAT_LOST_MS plus one refresh period.

config BOARD_FAULT_RESET
    bool "Reset on panic/fault"
    default n
    help
        When enabled, HardFault and panic dump the fault frame and then
        call NVIC_SystemReset. With IWDG enabled, leaving it disabled also
        results in a watchdog reset after the timeout; keep it disabled
        when a debugger needs to inspect the halted state.

endmenu
