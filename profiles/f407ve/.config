CONFIG_FW_PLATFORM_STM32F407VE=y
CONFIG_RT_NAME_MAX=8
CONFIG_RT_ALIGN_SIZE=8
CONFIG_RT_THREAD_PRIORITY_MAX=32
CONFIG_RT_TICK_PER_SECOND=1000
CONFIG_RT_USING_CONSOLE=y
CONFIG_RT_CONSOLEBUF_SIZE=256
CONFIG_RT_USING_OVERFLOW_CHECK=y
CONFIG_RT_USING_SEMAPHORE=y
CONFIG_RT_USING_HEAP=n
CONFIG_BOARD_LED_ENABLE=y
CONFIG_BOARD_UART_BAUD=115200
CONFIG_BOARD_UART_IRQ_PRIORITY=6
CONFIG_BOARD_LCD_ENABLE=y
CONFIG_APP_BOOT_IMAGE=y
CONFIG_FW_DEV_MAX=16
CONFIG_FW_USING_PIN=y
CONFIG_FW_USING_SERIAL=y
CONFIG_FW_USING_SPI=y
CONFIG_FW_USING_UART1=y
CONFIG_FW_USING_UART2=n
CONFIG_FW_USING_UART3=n
CONFIG_FW_USING_SPI1=y
CONFIG_FW_USING_SPI2=n
CONFIG_FW_USING_SPI3=n
CONFIG_FW_SERIAL_RX_BUFSZ=512
CONFIG_FW_SERIAL_TX_BUFSZ=512
CONFIG_FW_USE_PROTOCOL=y
CONFIG_APP_BOOT_DISPLAY=y
CONFIG_FW_USE_DISPLAY=y
CONFIG_FW_TASK_MAX=8
CONFIG_FW_USE_TASK=y
CONFIG_APP_RPC_TASK_STACK_SIZE=2048
CONFIG_APP_RPC_TASK_PRIORITY=9
CONFIG_APP_RPC_LOOP_WAIT_MAX_MS=500
CONFIG_APP_HEALTH_REFRESH_MS=1000
CONFIG_APP_TASK_HEARTBEAT_WARN_MS=1500
CONFIG_APP_TASK_HEARTBEAT_LOST_MS=3000
CONFIG_APP_TASK_STACK_WARN_BYTES=256
CONFIG_BOARD_MIN_STACK_SIZE=4096
CONFIG_BOARD_DMA_IRQ_PRIORITY=7
CONFIG_BOARD_EXTI_IRQ_PRIORITY=8
CONFIG_BOARD_SPI1_USE_MISO=n
CONFIG_BOARD_SPI1_MAX_HZ=12000000
CONFIG_BOARD_SPI2_USE_MISO=y
CONFIG_BOARD_SPI2_MAX_HZ=12000000
CONFIG_BOARD_SPI3_USE_MISO=y
CONFIG_BOARD_SPI3_MAX_HZ=12000000
